<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/guess1Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guess #1"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/guess1Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="@id/guess1Label"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/check1Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guess #1 Check"
        android:textSize="30sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/guess1Label"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/result1Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="@id/check1Label"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/guess2Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guess #2"
        android:textSize="30sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/check1Label"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/guess2Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="@id/guess2Label"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/check2Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guess #2 Check"
        android:textSize="30sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/guess2Label"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/result2Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="@id/check2Label"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/guess3Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guess #3"
        android:textSize="30sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/check2Label"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/guess3Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="@id/guess3Label"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/check3Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guess #3 Check"
        android:textSize="30sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/guess3Label"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/result3Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="@id/check3Label"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/answerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="50sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guessInput"
        android:layout_marginBottom="40dp" />

    <EditText
        android:id="@+id/guessInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter 4 letter guess here"
        android:inputType="text"
        android:maxLength="4"
        android:singleLine="true"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/submitButton"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/submitButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GUESS!"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>